{
  "name": "forgeon",
  "version": "0.3.22",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @forgeon/api --filter @forgeon/web dev",
    "build": "pnpm -r build",
    "postinstall": "pnpm --filter @forgeon/api prisma:generate",
    "create:forgeon": "node packages/create-forgeon/bin/create-forgeon.mjs",
    "release:patch": "node scripts/release-patch.mjs",
    "release:minor": "node scripts/release-patch.mjs --minor",
    "docker:up": "docker compose --env-file infra/docker/.env.example -f infra/docker/compose.yml up --build",
    "docker:down": "docker compose -f infra/docker/compose.yml down -v",
    "test:create-forgeon": "pnpm --dir packages/create-forgeon test",
    "smoke:generated-project": "pnpm --dir packages/create-forgeon smoke:generated-project",
    "test": "pnpm test:create-forgeon",
    "smoke:generated-project:full": "pnpm --dir packages/create-forgeon smoke:generated-project:full"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
